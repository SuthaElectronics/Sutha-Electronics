        function filterCategory(cat, btnElem) {
            document.querySelectorAll('.cat-pill').forEach(btn => {
                btn.className = "cat-pill px-4 py-2 rounded-full text-xs font-bold bg-slate-200 text-slate-700 hover:bg-slate-300";
            });
            
            const activeBtn = btnElem || (typeof window.event !== 'undefined' && window.event ? window.event.currentTarget : null);
            if (activeBtn && activeBtn.classList && activeBtn.classList.contains('cat-pill')) {
                activeBtn.className = "cat-pill active-pill px-4 py-2 rounded-full text-xs font-bold bg-navy-900 text-gold-500 shadow-sm";
            }

            if (cat === 'all') {
                renderProducts(products);
            } else {
                renderProducts(products.filter(p => p.category === cat));
            }
        }

        function handleSearch(q) {
            const query = (q || '').toLowerCase();
            const filtered = products.filter(p => p.name.toLowerCase().includes(query) || p.specs.toLowerCase().includes(query));
            renderProducts(filtered);
        }

        function sortProducts(val) {
            let list = [...products];
            if (val === 'low') list.sort((a,b) => a.price - b.price);
            if (val === 'high') list.sort((a,b) => b.price - a.price);
            if (val === 'rating') list.sort((a,b) => b.rating - a.rating);
            renderProducts(list);
        }

        function toggleSearch() {
            const box = document.getElementById('searchBox');
            if (box) {
                box.classList.toggle('hidden');
                if (!box.classList.contains('hidden')) {
