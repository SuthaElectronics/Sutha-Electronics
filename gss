        function addToCart(id) {
            const item = products.find(p => p.id === id);
            if (!item) return;
            const exist = cart.find(c => c.id === id);
            if (exist) {
                exist.qty += 1;
            } else {
                cart.push({ ...item, qty: 1 });
            }
            saveCartState();
            updateCartUI();
            showToast(`Added "${item.name}" to cart!`, 'success');
        }

        function quickAddProduct(id) {
            addToCart(id);
            openCartDrawer();
        }

        function changeQty(id, delta) {
            const idx = cart.findIndex(c => c.id === id);
            if (idx !== -1) {
                cart[idx].qty += delta;
                if (cart[idx].qty <= 0) cart.splice(idx, 1);
            }
            saveCartState();
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cartCountBadge');
            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            
            if (badge) {
                badge.textContent = totalQty;
                if (totalQty > 0) {
                    badge.classList.remove('scale-0');
                } else {
                    badge.classList.add('scale-0');
                }
            }

            const list = document.getElementById('cartItemsList');
            if (!list) return;
            list.innerHTML = '';

            if (cart.length === 0) {
                list.innerHTML = `
                    <div class="text-center py-12 text-slate-400">
                        <i class="fa-solid fa-cart-flatbed text-5xl mb-3 text-slate-300"></i>
                        <p class="font-bold text-sm text-slate-600">Your shopping cart is empty</p>
                        <p class="text-xs text-slate-400">Add LED products to build your order.</p>
                    </div>
                `;
            } else {
                cart.forEach(item => {
                    const row = document.createElement('div');
                    row.className = "flex items-center justify-between p-3 rounded-2xl bg-slate-50 border border-slate-200 gap-3";
                    row.innerHTML = `
                        <div class="w-10 h-10 rounded-xl bg-navy-900 text-gold-500 flex items-center justify-center shrink-0">
                            <i class="fa-solid ${item.icon}"></i>
                        </div>
