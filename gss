                        </div>
                        <div class="flex items-center gap-2 bg-white px-2 py-1 rounded-lg border border-slate-200">
                            <button onclick="changeQty(${item.id}, -1)" class="text-xs font-bold text-slate-500 hover:text-red-500">-</button>
                            <span class="text-xs font-bold w-4 text-center">${item.qty}</span>
                            <button onclick="changeQty(${item.id}, 1)" class="text-xs font-bold text-slate-500 hover:text-emerald-500">+</button>
                        </div>
                    `;
                    list.appendChild(row);
                });
            }

            const grossTotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const discount = grossTotal * discountRate;
            const finalPayable = Math.max(0, grossTotal - discount);

            const taxableValue = finalPayable / 1.18;
            const totalGST = finalPayable - taxableValue;
            const cgst = totalGST / 2;
            const sgst = totalGST / 2;

            const taxEl = document.getElementById('cartTaxable');
            const cgstEl = document.getElementById('cartCGST');
            const sgstEl = document.getElementById('cartSGST');
            const discEl = document.getElementById('cartDiscount');
            const totEl = document.getElementById('cartTotal');
            const chkEl = document.getElementById('checkoutAmount');

            if (taxEl) taxEl.textContent = `₹${taxableValue.toFixed(2)}`;
            if (cgstEl) cgstEl.textContent = `₹${cgst.toFixed(2)}`;
            if (sgstEl) sgstEl.textContent = `₹${sgst.toFixed(2)}`;
            if (discEl) discEl.textContent = `-₹${discount.toFixed(2)}`;
            if (totEl) totEl.textContent = `₹${finalPayable.toLocaleString('en-IN')}`;
            if (chkEl) chkEl.textContent = `₹${finalPayable.toLocaleString('en-IN')}`;
        }

