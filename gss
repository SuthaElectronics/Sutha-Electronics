        function calculateSavings() {
            const countEl = document.getElementById('calcCount');
            const hoursEl = document.getElementById('calcHours');
            const oldWattEl = document.getElementById('calcOldWatt');
            if (!countEl || !hoursEl || !oldWattEl) return;

            const count = parseInt(countEl.value) || 0;
            const hours = parseInt(hoursEl.value) || 0;
            const oldWatt = parseInt(oldWattEl.value) || 0;

            const countVal = document.getElementById('calcCountVal');
            const hoursVal = document.getElementById('calcHoursVal');
            if (countVal) countVal.textContent = `${count} Lights`;
            if (hoursVal) hoursVal.textContent = `${hours} Hours/Day`;

            const newWatt = Math.round(oldWatt * 0.18);
            
            const totalOldWatt = count * oldWatt;
            const totalNewWatt = count * newWatt;

            const dailyOldKWh = (totalOldWatt * hours) / 1000;
            const dailyNewKWh = (totalNewWatt * hours) / 1000;

            const annualKWhSaved = (dailyOldKWh - dailyNewKWh) * 365;
            
            const annualSavingsRupees = Math.round(annualKWhSaved * 8);
            const co2SavedKg = Math.round(annualKWhSaved * 0.82);

            const savingsEl = document.getElementById('savingsAmount');
            const co2El = document.getElementById('co2Val');
            const oldPowerEl = document.getElementById('oldPower');
            const newPowerEl = document.getElementById('newPower');

            if (savingsEl) savingsEl.textContent = `₹${annualSavingsRupees.toLocaleString('en-IN')} / year`;
            if (co2El) co2El.textContent = `${co2SavedKg} kg`;
            if (oldPowerEl) oldPowerEl.textContent = `${totalOldWatt}W`;
            if (newPowerEl) newPowerEl.textContent = `${totalNewWatt}W`;
        }

        function handleQuoteSubmit(e) {
